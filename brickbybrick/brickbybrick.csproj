<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Resolve Vintage Story from an explicit path, the repo-local mirror, then the normal environment. -->
    <VintageStoryMirrorDir>$(MSBuildThisFileDirectory)..\.local\vintagestory</VintageStoryMirrorDir>
    <VintageStoryDir Condition="'$(VintageStoryDir)' == '' And Exists('$(VintageStoryMirrorDir)\VintagestoryAPI.dll')">$(VintageStoryMirrorDir)</VintageStoryDir>
    <VintageStoryDir Condition="'$(VintageStoryDir)' == '' And '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryDir>
    <NewtonsoftJsonPath>$(VintageStoryDir)\Lib\Newtonsoft.Json.dll</NewtonsoftJsonPath>
    <NewtonsoftJsonPath Condition="!Exists('$(NewtonsoftJsonPath)') And '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)\Lib\Newtonsoft.Json.dll</NewtonsoftJsonPath>
    <ProtobufNetPath>$(VintageStoryDir)\Lib\protobuf-net.dll</ProtobufNetPath>
    <ProtobufNetPath Condition="!Exists('$(ProtobufNetPath)') And '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)\Lib\protobuf-net.dll</ProtobufNetPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CraluminumMods.VintageStory.AttributeRenderingLibrary" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryDir)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintageStoryDir)\Mods\VSSurvivalMod.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VintageStoryDir)\Mods\VSEssentials.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VSCreativeMod">
      <HintPath>$(VintageStoryDir)\Mods\VSCreativeMod.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryDir)\Lib\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryDir)\VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(NewtonsoftJsonPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(ProtobufNetPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

<ItemGroup>
  <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Content Include="modicon.png" Condition="Exists('modicon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Folder Include="assets\brickbybrick\sounds\block\" />
</ItemGroup>
	
</Project>
